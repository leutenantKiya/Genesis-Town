# Copy to .env and fill in. Never commit .env.
# Names only. Values come from your own accounts. See docs/architecture.md.

NEAR_NETWORK=testnet
NEAR_RPC_URL=
GAME_CONTRACT_ID=

# Server role accounts and their private keys (ed25519:...)
RELAYER_ACCOUNT_ID=
RELAYER_PRIVATE_KEYS=
MINTER_ACCOUNT_ID=
MINTER_PRIVATE_KEY=
TOWN_ACCOUNT_ID=
TOWN_PRIVATE_KEY=
PLAYERS_PARENT_ACCOUNT_ID=
PLAYERS_PARENT_PRIVATE_KEY=

# Merchants: function-call key + quote-signing key each
MERCHANT_SARI_PRIVATE_KEY=
MERCHANT_SARI_QUOTE_KEY=
MERCHANT_BUDI_PRIVATE_KEY=
MERCHANT_BUDI_QUOTE_KEY=
MERCHANT_WATI_PRIVATE_KEY=
MERCHANT_WATI_QUOTE_KEY=
MERCHANT_JOKO_PRIVATE_KEY=
MERCHANT_JOKO_QUOTE_KEY=

# NEAR Auth (testnet uses the shared client id from the NEAR Auth testnet docs)
FASTAUTH_CLIENT_ID=

# NEAR AI Cloud (optional; without it the local rule brain is used)
NEARAI_API_KEY=
NEARAI_MODEL=

# Relayer limits
RELAY_MAX_PER_MINUTE=30
RELAY_MAX_PER_DAY=2000
