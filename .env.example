# Copy to .env and fill in. Never commit .env.
# Names only. Values come from your own accounts. See docs/architecture.md.

NEAR_NETWORK=testnet
# Empty = https://test.rpc.fastnear.com (from docs.near.org/api/rpc/providers)
NEAR_RPC_URL=
GAME_CONTRACT_ID=

# Server role accounts and their private keys (ed25519:...)
RELAYER_ACCOUNT_ID=
RELAYER_PRIVATE_KEYS=
SETTLER_ACCOUNT_ID=
SETTLER_PRIVATE_KEY=
TOWN_ACCOUNT_ID=
TOWN_PRIVATE_KEY=
PLAYERS_PARENT_ACCOUNT_ID=
PLAYERS_PARENT_PRIVATE_KEY=

# Merchants (sari/budi/wati/joko.<parent>) need no keys on the server: their balances change only through settlement.
MERCHANT_PARENT_ACCOUNT_ID=

# Seed of the shared village map (client/js/world/village.js). Empty = 20261114. A new seed means a new world.
WORLD_SEED=

# Dev panel (clock jump, Settle sekarang). Leave empty in a public deployment; even when on, it only answers
# direct requests from this machine (no proxy headers).
DEV_TOOLS=1

# Set to 1 on a host behind a proxy (Railway, Render, Fly, nginx...): per-address limits then use the visitor's
# address from X-Forwarded-For instead of the proxy's. Leave empty when running directly on your machine.
TRUST_PROXY=

# NEAR Auth (testnet uses the shared client id from the NEAR Auth testnet docs)
FASTAUTH_CLIENT_ID=

# NEAR AI Cloud merchant dialogue (optional; without a key, merchants answer with local lines from the same prices).
# Key from https://cloud.near.ai. NEARAI_MODEL pins a model id; if empty, the first model from GET /v1/models is used
# (the server logs which one).
NEARAI_API_KEY=
NEARAI_MODEL=
NEARAI_BASE_URL=https://cloud-api.near.ai/v1
NEARAI_TIMEOUT_MS=8000

# Relayer limits
RELAY_MAX_PER_MINUTE=30
RELAY_MAX_PER_DAY=2000
