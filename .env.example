# Copy to .env and fill in. Never commit .env.
# Names only. Values come from your own accounts. See docs/architecture.md.

NEAR_NETWORK=testnet
# Empty = https://test.rpc.fastnear.com (from docs.near.org/api/rpc/providers)
NEAR_RPC_URL=
GAME_CONTRACT_ID=

# Server role accounts and their private keys (ed25519:...)
RELAYER_ACCOUNT_ID=
RELAYER_PRIVATE_KEYS=
SETTLER_ACCOUNT_ID=
SETTLER_PRIVATE_KEY=
TOWN_ACCOUNT_ID=
TOWN_PRIVATE_KEY=
PLAYERS_PARENT_ACCOUNT_ID=
PLAYERS_PARENT_PRIVATE_KEY=

# Merchants (sari/budi/wati/joko.<parent>) need no keys on the server: their balances change only through settlement.
MERCHANT_PARENT_ACCOUNT_ID=

# Seed of the shared village map (client/js/world/village.js). Empty = 20261114. A new seed means a new world.
WORLD_SEED=

# Dev panel (clock jump, Settle sekarang). Leave empty in a public deployment; even when on, it only answers
# direct requests from this machine (no proxy headers).
DEV_TOOLS=1

# Set to 1 on a host behind a proxy (Railway, Render, Fly, nginx...): per-address limits then use the visitor's
# address from X-Forwarded-For instead of the proxy's. Leave empty when running directly on your machine.
TRUST_PROXY=

# Client hosted apart from this server (e.g. on Vercel): its origin(s), comma separated, e.g.
# https://genesis-town.vercel.app. Browsers on those pages may then call /api/* cross-origin. Empty: same origin only.
# The client itself is built with GT_API_BASE=https://<this server's public URL> (see docs/deploy.md).
CORS_ORIGINS=

# Our own NEAR Auth deployment (docs/fastauth-fork-plan.md). All four are needed for any login, Google included: they fix each
# player's owner key. With any of them empty nobody can sign in. There is no fallback to NEAR's shared (public) NEAR Auth.
# FASTAUTH_DOMAIN=genesis-town.us.auth0.com
# FASTAUTH_CLIENT_ID=<the Auth0 SPA client id>
# FASTAUTH_CONTRACT_ID=fa.genesistown.testnet
# FASTAUTH_SIGNING_AUDIENCE=auth0.jwt.fa.genesistown.testnet
# Page origins where NEAR Auth's login is allowed to return (comma separated; our Auth0 tenant's allowed callbacks).
# Elsewhere the game hides NEAR Auth.
NEAR_AUTH_ORIGINS=http://localhost:3000

# "Masuk dengan Google" (optional): OAuth client id of type "Web application" from
# https://console.developers.google.com/auth/clients, with the game's origins under Authorized JavaScript origins
# (e.g. https://genesistown.up.railway.app, http://localhost:3000 and http://localhost). No client secret is used.
# Empty: only the NEAR Auth button shows.
GOOGLE_CLIENT_ID=

# NEAR AI Cloud merchant dialogue (optional; without a key, merchants answer with local lines from the same prices).
# Key from https://cloud.near.ai. NEARAI_MODEL pins a model id; if empty, the first model from GET /v1/models is used
# (the server logs which one).
NEARAI_API_KEY=
NEARAI_MODEL=
NEARAI_BASE_URL=https://cloud-api.near.ai/v1
NEARAI_TIMEOUT_MS=8000

# Which AI writes merchant lines (developer only; the client cannot choose). DIALOGUE_PROVIDER = anthropic | nearai | local;
# empty means: anthropic if ANTHROPIC_API_KEY is set, else nearai if NEARAI_API_KEY is set, else local lines.
# DIALOGUE_MODEL defaults to claude-sonnet-5-5 (low effort).
DIALOGUE_PROVIDER=
ANTHROPIC_API_KEY=
DIALOGUE_MODEL=

# Relayer limits
RELAY_MAX_PER_MINUTE=30
RELAY_MAX_PER_DAY=2000

# Neon Postgres keeps a copy of the SQLite database (server/src/snapshot.ts), for hosts without a disk.
# The direct connection string (host without -pooler). Testnet chain only; the mock chain ignores it.
DATABASE_URL=
# How often to save the copy when something changed (minutes, default 0.25 = every 15 s; at least 0.25).
SNAPSHOT_MINUTES=
# Every spend (sell, buy, craft, trade...) is also checked against the player's token balance in the game contract on chain (settled part).
# CHAIN_CHECK = off (default: spends read the game's books only) | lenient (also compare with the chain; allow when it cannot be read) | strict (refuse when it cannot be read in time).
# CHAIN_CHECK_TTL_MS = how long a balance read from the network is reused per account (default 15000).
CHAIN_CHECK=
CHAIN_CHECK_TTL_MS=
# Warn (log and /api/health) when the settler, relayer or players' parent has less NEAR than this left for gas.
FUNDS_LOW_NEAR=

# Accounts allowed to use the in-game Admin panel (guests online, kick, ban IPs): comma-separated NEAR account ids
# of the players, e.g. abc123.players.testnet,def456.players.testnet. Empty: nobody is admin.
ADMIN_ACCOUNTS=
